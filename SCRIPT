-- 3. ФУНКЦИЯ СОЗДАНИЯ ПЛАВНОГО ПЕРЕКЛЮЧАТЕЛЯ
-- ============================================================
local function createSwitch(yPos, labelText, callback)
    local Container = Instance.new("Frame")
    Container.Parent = MainFrame
    Container.Size = UDim2.new(1, -30, 0, 50)
    Container.Position = UDim2.new(0, 15, 0, yPos)
    Container.BackgroundTransparency = 1

    local Label = Instance.new("TextLabel")
    Label.Parent = Container
    Label.Size = UDim2.new(0, 150, 1, 0)
    Label.BackgroundTransparency = 1
    Label.Text = labelText
    Label.TextColor3 = Color3.fromRGB(220, 220, 220)
    Label.TextSize = 13
    Label.Font = Enum.Font.Gotham
    Label.TextXAlignment = Enum.TextXAlignment.Left

    local SwitchBg = Instance.new("Frame")
    SwitchBg.Parent = Container
    SwitchBg.Size = UDim2.new(0, 50, 0, 28)
    SwitchBg.Position = UDim2.new(1, -50, 0.5, -14)
    SwitchBg.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    
    local BgCorner = Instance.new("UICorner")
    BgCorner.Parent = SwitchBg
    BgCorner.CornerRadius = UDim.new(1, 0)

    local Knob = Instance.new("Frame")
    Knob.Parent = SwitchBg
    Knob.Size = UDim2.new(0, 22, 0, 22)
    Knob.Position = UDim2.new(0, 3, 0.5, -11)
    Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)

    local KnobCorner = Instance.new("UICorner")
    KnobCorner.Parent = Knob
    KnobCorner.CornerRadius = UDim.new(1, 0)

    local isOn = false

    local function updateSwitch()
        isOn = not isOn
        local targetColor = isOn and Color3.fromRGB(255, 70, 70) or Color3.fromRGB(60, 60, 60)
        local knobPos = isOn and UDim2.new(1, -25, 0.5, -11) or UDim2.new(0, 3, 0.5, -11)

        TweenService:Create(SwitchBg, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = targetColor
        }):Play()

        TweenService:Create(Knob, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = knobPos
        }):Play()

        if callback then callback(isOn) end
    end

    local ClickDetector = Instance.new("TextButton")
    ClickDetector.Parent = Container
    ClickDetector.Size = UDim2.new(1, 0, 1, 0)
    ClickDetector.BackgroundTransparency = 1
    ClickDetector.Text = ""

    ClickDetector.MouseButton1Click:Connect(updateSwitch)

    return { toggle = updateSwitch, getState = function() return isOn end }
end

