-- === ЛОГИКА ДЮПА ===
local isDuping = false
local dupProgress = 0
local dupConnection = nil
local dupStartTime = 0

local function resetDup()
    isDuping = false
    dupProgress = 0
    progressFrame.Visible = false
    completeText.Visible = false
    dupBtn.Text = "▶ Дюп"
    dupBtn.BackgroundColor3 = Color3.fromRGB(255, 70, 70)
    progBar.Size = UDim2.new(0, 0, 1, 0)
    progLabel.Text = "Дюп: 0%"
    if dupConnection then
        dupConnection:Disconnect()
        dupConnection = nil
    end
end

local function startDup()
    if isDuping then return end
    
    resetDup()
    isDuping = true
    dupProgress = 0
    dupStartTime = tick()
    
    progressFrame.Visible = true
    completeText.Visible = false
    dupBtn.Text = "⏹ Стоп"
    dupBtn.BackgroundColor3 = Color3.fromRGB(255, 200, 50)
    progBar.Size = UDim2.new(0, 0, 1, 0)
    progLabel.Text = "Дюп: 0%"
    
    -- Анимация появления
    progressFrame.BackgroundTransparency = 1
    TweenService:Create(progressFrame, TweenInfo.new(0.3, Enum.EasingStyle.Sine), {BackgroundTransparency = 0.4}):Play()
    
    dupConnection = RunService.Heartbeat:Connect(function()
        local elapsed = tick() - dupStartTime
        dupProgress = math.min(elapsed / 60 * 100, 100)
        
        -- ШИРИНА ШКАЛЫ (от 0 до 100% контейнера)
        local width = dupProgress / 100
        progBar.Size = UDim2.new(width, 0, 1, 0)
        progLabel.Text = string.format("Дюп: %.1f%%", dupProgress)
        
        -- Цвет
        if dupProgress > 80 then
            progBar.BackgroundColor3 = Color3.fromRGB(255, 200, 50)
        elseif dupProgress > 50 then
            progBar.BackgroundColor3 = Color3.fromRGB(255, 150, 50)
        else
            progBar.BackgroundColor3 = Color3.fromRGB(0, 200, 255)
        end
        
        -- Завершение
        if dupProgress >= 100 then
            completeText.Text = "✅ Успешно задюпано!"
            completeText.Visible = true
            dupBtn.Text = "✅ Готово"
            dupBtn.BackgroundColor3 = Color3.fromRGB(70, 255, 70)
            
            if dupConnection then
                dupConnection:Disconnect()
                dupConnection = nil
            end
            isDuping = false
            
            task.wait(4)
            resetDup()
        end
    end)
end

dupBtn.MouseButton1Click:Connect(function()
    if isDuping then
        resetDup()
        progressFrame.Visible = false
        dupBtn.Text = "▶ Дюп"
        dupBtn.BackgroundColor3 = Color3.fromRGB(255, 70, 70)
    else
        startDup()
    end
end)

