    mainMenu.Size = UDim2.new(0, 0, 0, 0)
    mainMenu.Position = UDim2.new(0.5, 0, 0.5, 0)
    
    TweenService:Create(mainMenu, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        BackgroundTransparency = 0.15,
        Size = menuSize,
        Position = menuPosition
    }):Play()
end

-- Обработчик открытия меню
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.RightControl then
        if mainMenu.Visible then
            TweenService:Create(mainMenu, TweenInfo.new(0.3, Enum.EasingStyle.Sine), {
                Size = UDim2.new(0, 0, 0, 0),
                Position = UDim2.new(0.5, 0, 0.5, 0),
                BackgroundTransparency = 1
            }):Play()
            task.wait(0.3)
            mainMenu.Visible = false
        else
            -- Восстанавливаем нормальные параметры перед показом
            mainMenu.BackgroundTransparency = 0.15
            mainMenu.Size = menuSize
            mainMenu.Position = menuPosition
            showMenu()
        end
    end
end)

