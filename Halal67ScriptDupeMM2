-- Переменные для дюпа
local isDuping = false
local dupProgress = 0
local dupConnection = nil
local dupStartTime = 0

local function resetDupUI()
    isDuping = false
    dupProgress = 0
    progressFrame.Visible = false
    completeLabel.Visible = false
    dupButton.Text = "▶ Дюп"
    dupButton.BackgroundColor3 = Color3.fromRGB(255, 70, 70)
    progressBar.Size = UDim2.new(0, 0, 0.5, 0) -- Сбрасываем шкалу в 0
    progressLabel.Text = "Дюп: 0%"
    if dupConnection then
        dupConnection:Disconnect()
        dupConnection = nil
    end
end

local function startDup()
    if isDuping then return end
    
    resetDupUI()
    isDuping = true
    dupProgress = 0
    dupStartTime = tick()
    progressFrame.Visible = true
    progressFrame.BackgroundTransparency = 0.3
    completeLabel.Visible = false
    dupButton.Text = "⏹ Стоп"
    dupButton.BackgroundColor3 = Color3.fromRGB(255, 200, 50)
    progressBar.Size = UDim2.new(0, 0, 0.5, 0) -- Убеждаемся, что шкала с 0
    
    -- Анимация появления шкалы
    progressFrame.BackgroundTransparency = 1
    TweenService:Create(progressFrame, TweenInfo.new(0.3, Enum.EasingStyle.Sine), {BackgroundTransparency = 0.3}):Play()
    
    dupConnection = RunService.Heartbeat:Connect(function()
        local elapsed = tick() - dupStartTime
        dupProgress = math.min(elapsed / 60 * 100, 100)
        
        -- Обновляем шкалу (с 0 до 100%)
        local barWidth = dupProgress / 100
        TweenService:Create(progressBar, TweenInfo.new(0.1, Enum.EasingStyle.Linear), {
            Size = UDim2.new(barWidth * 0.7, 0, 0.5, 0)
        }):Play()
        
        progressLabel.Text = string.format("Дюп: %.1f%%", dupProgress)
        
        -- Меняем цвет шкалы
        if dupProgress > 80 then
            progressBar.BackgroundColor3 = Color3.fromRGB(255, 200, 50)
        elseif dupProgress > 50 then
            progressBar.BackgroundColor3 = Color3.fromRGB(255, 150, 50)
        else
            progressBar.BackgroundColor3 = Color3.fromRGB(0, 200, 255)
        end
        
        -- Проверка завершения
        if dupProgress >= 100 then
            completeLabel.Text = "✅ Успешно задюпано! Если у вас пустой инвентарь то мы задюпали воздух XD"
            completeLabel.Visible = true
            dupButton.Text = "✅ Готово"
            dupButton.BackgroundColor3 = Color3.fromRGB(70, 255, 70)
            
            TweenService:Create(progressFrame, TweenInfo.new(0.5, Enum.EasingStyle.Sine), {
                BackgroundColor3 = Color3.fromRGB(50, 150, 50)
            }):Play()
            
            print("Дюп завершен!")
            
            if dupConnection then
                dupConnection:Disconnect()
                dupConnection = nil
            end
            isDuping = false
            
            task.wait(5)
            resetDupUI()
        end
    end)
end

dupButton.MouseButton1Click:Connect(function()
    if isDuping then
        resetDupUI()
        progressFrame.Visible = false
        dupButton.Text = "▶ Дюп"
        dupButton.BackgroundColor3 = Color3.fromRGB(255, 70, 70)
    else
        startDup()
    end
end)

