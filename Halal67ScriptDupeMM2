local function updateSlider(instant)
    local targetSize = acEnabled and UDim2.new(1, 0, 1, 0) or UDim2.new(0, 0, 1, 0)
    local btnPos = acEnabled and UDim2.new(1, -8, 0, 1) or UDim2.new(0, -8, 0, 1)
    local color = acEnabled and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(0, 200, 255)
    
    if instant then
        sliderFill.Size = targetSize
        sliderBtn.Position = btnPos
        sliderFill.BackgroundColor3 = color
        sliderBtn.BackgroundColor3 = color
        return
    end
    
    TweenService:Create(sliderFill, TweenInfo.new(0.3, Enum.EasingStyle.Sine), {Size = targetSize}):Play()
    TweenService:Create(sliderBtn, TweenInfo.new(0.3, Enum.EasingStyle.Sine), {Position = btnPos}):Play()
    TweenService:Create(sliderFill, TweenInfo.new(0.3, Enum.EasingStyle.Sine), {BackgroundColor3 = color}):Play()
    TweenService:Create(sliderBtn, TweenInfo.new(0.3, Enum.EasingStyle.Sine), {BackgroundColor3 = color}):Play()
end

