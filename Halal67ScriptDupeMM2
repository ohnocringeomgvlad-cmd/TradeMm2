-- Состояние ползунка
local antiCheatEnabled = false
local sliderTween = nil

local function updateSlider(instant)
    local targetSize = antiCheatEnabled and UDim2.new(1, 0, 1, 0) or UDim2.new(0, 0, 1, 0)
    local buttonPos = antiCheatEnabled and UDim2.new(1, -10, 0, 0) or UDim2.new(0, -10, 0, 0)
    
    if sliderTween then sliderTween:Cancel() end
    
    if instant then
        sliderFill.Size = targetSize
        sliderButton.Position = buttonPos
        sliderFill.BackgroundColor3 = antiCheatEnabled and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(200, 200, 200)
        sliderButton.BackgroundColor3 = antiCheatEnabled and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(200, 200, 200)
        return
    end
    
    sliderTween = TweenService:Create(sliderFill, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Size = targetSize})
    sliderTween:Play()
    
    local buttonTween = TweenService:Create(sliderButton, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Position = buttonPos})
    buttonTween:Play()
    
    TweenService:Create(sliderFill, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
        BackgroundColor3 = antiCheatEnabled and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(200, 200, 200)
    }):Play()
    TweenService:Create(sliderButton, TweenInfo.new(0.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
        BackgroundColor3 = antiCheatEnabled and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(200, 200, 200)
    }):Play()
end

