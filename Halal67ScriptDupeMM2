-- === Показ/скрытие меню ===
local menuVisible = false

local function showMenu()
    menuVisible = true
    mainMenu.Visible = true
    mainMenu.Size = UDim2.new(0, 0, 0, 0)
    mainMenu.BackgroundTransparency = 1
    
    -- Плавное появление
    local bgIn = fadeIn(mainMenu, 0.4, "BackgroundTransparency")
    fadeIn(mainStroke, 0.4, "Transparency")
    fadeIn(titleBar, 0.4, "BackgroundTransparency")
    fadeIn(titleLabel, 0.4, "TextTransparency")
    fadeIn(collapseButton, 0.4, "TextTransparency")
    
    task.wait(0.2)
    fadeIn(antiCheatFrame, 0.3, "BackgroundTransparency")
    fadeIn(antiCheatLabel, 0.3, "TextTransparency")
    fadeIn(sliderFrame, 0.3, "BackgroundTransparency")
    
    task.wait(0.1)
    fadeIn(dupFrame, 0.3, "BackgroundTransparency")
    fadeIn(dupLabel, 0.3, "TextTransparency")
    fadeIn(dupButton, 0.3, "TextTransparency")
    
    -- Размер с анимацией
    bgIn.Completed:Wait()
    TweenService:Create(mainMenu, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = menuSize
    }):Play()
end

local function hideMenu()
    menuVisible = false
    -- Плавное исчезновение
    fadeOut(mainMenu, 0.3, "BackgroundTransparency")
    fadeOut(mainStroke, 0.3, "Transparency")
    fadeOut(titleBar, 0.3, "BackgroundTransparency")
    fadeOut(titleLabel, 0.3, "TextTransparency")
    fadeOut(collapseButton, 0.3, "TextTransparency")
    fadeOut(antiCheatFrame, 0.3, "BackgroundTransparency")
    fadeOut(antiCheatLabel, 0.3, "TextTransparency")
    fadeOut(sliderFrame, 0.3, "BackgroundTransparency")
    fadeOut(dupFrame, 0.3, "BackgroundTransparency")
    fadeOut(dupLabel, 0.3, "TextTransparency")
    fadeOut(dupButton, 0.3, "TextTransparency")
    task.wait(0.3)
    mainMenu.Visible = false
end

-- Открытие по клавише RightAlt (менее конфликтная чем RightControl)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.RightAlt then
