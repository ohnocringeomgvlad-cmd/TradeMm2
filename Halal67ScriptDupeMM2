local function toggleMenu(show)
    if show then
        mainMenu.Visible = true
        mainMenu.BackgroundTransparency = 1
        mainMenu.Size = UDim2.new(0, 0, 0, 0)
        mainMenu.Position = UDim2.new(0.5, 0, 0.5, 0)
        mainMenu.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
        
        TweenService:Create(mainMenu, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            BackgroundTransparency = 0.1,
            Size = UDim2.new(0, 250, 0, 280),
            Position = UDim2.new(0.5, -125, 0.5, -140)
        }):Play()
    else
        TweenService:Create(mainMenu, TweenInfo.new(0.3, Enum.EasingStyle.Sine), {
            Size = UDim2.new(0, 0, 0, 0),
            Position = UDim2.new(0.5, 0, 0.5, 0),
            BackgroundTransparency = 1
        }):Play()
        task.wait(0.3)
        mainMenu.Visible = false
    end
end

