-- === Логика дюпа ===
local isDuping = false
local dupConnection = nil
local dupStartTime = 0

local function resetDupUI()
    isDuping = false
    if dupConnection then
        dupConnection:Disconnect()
        dupConnection = nil
    end
    progressFrame.Visible = false
    completeLabel.Visible = false
    completeLabel.Text = ""
    dupButton.Text = "▶ Дюп"
    dupButton.BackgroundColor3 = Color3.fromRGB(255, 70, 70)
    pbFill.Size = UDim2.new(0, 0, 1, 0)
    progressLabel.Text = "Дюп: 0%"
end

local function startDup()
    if isDuping then return end
    isDuping = true
    dupStartTime = tick()
    progressFrame.Visible = true
    progressFrame.BackgroundTransparency = 1
    fadeIn(progressFrame, 0.3, "BackgroundTransparency")
    fadeIn(progressLabel, 0.3, "TextTransparency")
    fadeIn(progressBar, 0.3, "BackgroundTransparency")
    completeLabel.Visible = false
    dupButton.Text = "⏹ Стоп"
    dupButton.BackgroundColor3 = Color3.fromRGB(255, 200, 50)
    
    dupConnection = RunService.Heartbeat:Connect(function()
        if not isDuping then return end -- защита
        
        local elapsed = tick() - dupStartTime
        local progress = math.min(elapsed / 60 * 100, 100)
        
        -- Плавное заполнение
        TweenService:Create(pbFill, TweenInfo.new(0.1, Enum.EasingStyle.Linear), {
            Size = UDim2.new(progress / 100, 0, 1, 0)
        }):Play()
        
        progressLabel.Text = string.format("Дюп: %.1f%%", progress)
        
        -- Цвет шкалы
        if progress > 80 then
            pbFill.BackgroundColor3 = Color3.fromRGB(255, 200, 50)
        elseif progress > 50 then
            pbFill.BackgroundColor3 = Color3.fromRGB(255, 150, 50)
        else
            pbFill.BackgroundColor3 = Color3.fromRGB(0, 200, 255)
        end
        
        -- Завершение
        if progress >= 100 then
            isDuping = false
            if dupConnection then
                dupConnection:Disconnect()
                dupConnection = nil
            end
            completeLabel.Text = "✅ Успешно задюпано! Если у вас пустой инвентарь то мы задюпали воздух XD"
            completeLabel.Visible = true
            fadeIn(completeLabel, 0.3, "TextTransparency")
            dupButton.Text = "✅ Готово"
            dupButton.BackgroundColor3 = Color3.fromRGB(70, 255, 70)
            print("[CoolMenu] Дюп завершён!")
            
            -- Авто-сброс через 5 сек
            task.delay(5, function()
                if not isDuping then
                    resetDupUI()
                end
            end)
        end
    end)
end

dupButton.MouseButton1Click:Connect(function()
