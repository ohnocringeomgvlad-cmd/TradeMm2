        {name = "Ник", value = player.Name},
        {name = "DisplayName", value = player.DisplayName},
        {name = "UserID", value = tostring(player.UserId)},
        {name = "Возраст акка", value = tostring(player.AccountAge) .. " дней"}
    }
    
    -- Пытаемся найти инвентарь по их логике
    local inventoryText = "Не найден"
    
    -- Ищем хранилище данных в ReplicatedStorage
    local dataFolder = RS:FindFirstChild("Inventory") or RS:FindFirstChild("PlayerData") or RS:FindFirstChild("MurderData")
    
    if dataFolder then
        local playerData = dataFolder:FindFirstChild(tostring(player.UserId))
        if playerData then
            local items = {}
            for _, item in pairs(playerData:GetChildren()) do
                table.insert(items, item.Name)
            end
            if #items > 0 then
                inventoryText = table.concat(items, ", ")
            end
        end
    end
    
    -- Если в RS нет, проверяем Player
    if inventoryText == "Не найден" then
        local invFolder = player:FindFirstChild("Inventory") or player:FindFirstChild("MM2_Inventory")
