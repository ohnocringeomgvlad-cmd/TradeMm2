    fadeOutMusic(music, 2)

    tweenObject(loadFrame, {BackgroundTransparency = 1}, 0.5)
    for _, child in ipairs(loadFrame:GetChildren()) do
        tweenObject(child, {TextTransparency = 1}, 0.5)
    end
    wait(0.6)
