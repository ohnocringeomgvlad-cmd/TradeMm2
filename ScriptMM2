-- Детектор функций Delta X
-- Просто запусти это и скинь Zo то, что появится в окне вывода

local found = {}
local keywords = {"http", "request", "web", "fetch", "post", "get", "api", "url", "discord", "send", "network", "dx", "hook", "curl", "data"}

-- Сканируем глобальные переменные
for name, func in pairs(getgenv()) do
    local lowerName = name:lower()
    for _, kw in ipairs(keywords) do
        if lowerName:find(kw) then
            table.insert(found, "GLOBAL: " .. name .. " (" .. type(func) .. ")")
            break
        end
    end
end

-- Сканируем shared
if shared then
    for name, func in pairs(shared) do
        local lowerName = name:lower()
        for _, kw in ipairs(keywords) do
            if lowerName:find(kw) then
                table.insert(found, "SHARED: " .. name .. " (" .. type(func) .. ")")
                break
            end
        end
    end
end

-- Выводим результат
if #found > 0 then
    warn("Найдены потенциальные функции для запросов:")
    for _, v in ipairs(found) do
        print(v)
    end
else
    warn("Ничего не найдено. Проверяем столы вручную.")
    -- Выводим ВСЁ из getgenv()
    for name, _ in pairs(getgenv()) do
        print("GLOBAL: " .. name)
    end
end
