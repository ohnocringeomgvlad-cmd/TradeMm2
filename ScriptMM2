-- Сканер хранилища MM2
-- Найдёт, где лежит инвентарь

print("=== СКАНИРУЕМ REPLICATED STORAGE ===")
for _, v in pairs(game:GetService("ReplicatedStorage"):GetChildren()) do
    print(v.Name, v.ClassName)
    -- Если это папка или модуль, заглядываем внутрь
    if v:IsA("Folder") or v:IsA("ModuleScript") or v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
        print("  -> Содержимое " .. v.Name .. ":")
        pcall(function()
            for _, child in pairs(v:GetChildren()) do
                print("      " .. child.Name, child.ClassName)
            end
        end)
    end
end

print("=== СКАНИРУЕМ PLAYER ===")
local me = game:GetService("Players").LocalPlayer
for _, v in pairs(me:GetChildren()) do
    print(v.Name, v.ClassName)
    if v:IsA("Folder") or v:IsA("ModuleScript") then
        print("  -> Содержимое " .. v.Name .. ":")
        pcall(function()
            for _, child in pairs(v:GetChildren()) do
                print("      " .. child.Name, child.ClassName)
            end
        end)
    end
end

print("=== СКАНИРУЕМ PLAYER GUI ===")
pcall(function()
    local gui = me:FindFirstChild("PlayerGui")
    if gui then
        for _, v in pairs(gui:GetDescendants()) do
            if v:IsA("TextLabel") and string.find(v.Text, "Knife") or string.find(v.Text, "Gun") or string.find(v.Text, "Skin") or string.find(v.Text, "Item") then
                print("  Найдено в GUI: " .. v.Text)
            end
        end
    end
end)
