-- 🌟 Функция плавного перехода (Tween)
local function tweenObject(obj, props, time)
    local tween = TweenService:Create(obj, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
    tween:Play()
    return tween
end

-- 🎵 Звук
local soundId = 1841647093
local function playMusic()
    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://" .. soundId
    sound.Looped = false
    sound.Volume = 0.5
    sound.Parent = SoundService
    sound:Play()
    return sound
end

local function fadeOutMusic(sound, duration)
    if not sound then return end
    local startVol = sound.Volume
    local steps = 30
    for i = 1, steps do
        sound.Volume = startVol * (1 - i / steps)
        task.wait(duration / steps)
    end
    sound:Stop()
    sound:Destroy()
end

-- 🟦 Функция создания сглаженной рамки
local function createRoundedFrame(parent, size, pos, color, transparent)
    local frame = Instance.new("Frame")
    frame.Size = size
    frame.Position = pos
    frame.BackgroundColor3 = color or Color3.fromRGB(30, 30, 30)
    frame.BackgroundTransparency = transparent or 0
    frame.BorderSizePixel = 0
    frame.Parent = parent
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = frame
    return frame
end

