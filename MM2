        local ThemeLabel = Instance.new("TextLabel")
        ThemeLabel.Parent = ExtraContainer
        ThemeLabel.Size = UDim2.new(1, 0, 0, 30)
        ThemeLabel.Position = UDim2.new(0, 0, 0, 60)
        ThemeLabel.BackgroundTransparency = 1
        ThemeLabel.Text = "Выберите тему:"
        ThemeLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
        ThemeLabel.TextSize = 14
        ThemeLabel.Font = Enum.Font.Gotham
        
        local ThemeList = Instance.new("Frame")
        ThemeList.Parent = ExtraContainer
        ThemeList.Size = UDim2.new(1, -20, 0, 150)
        ThemeList.Position = UDim2.new(0, 10, 0, 100)
        ThemeList.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        ThemeList.BackgroundTransparency = 0.5
        ThemeList.Visible = false
        local TLCorner = Instance.new("UICorner")
        TLCorner.Parent = ThemeList
        TLCorner.CornerRadius = UDim.new(0, 8)
        
        local themes = {"Синий", "Розовый", "Фиолетовый", "Красный", "Бордовый", "Радужный", "Оранжевый", "Белый", "Чёрный"}
        local themeColors = {
            ["Синий"] = Color3.fromRGB(50, 120, 200),
            ["Розовый"] = Color3.fromRGB(255, 100, 150),
            ["Фиолетовый"] = Color3.fromRGB(180, 80, 255),
            ["Красный"] = Color3.fromRGB(255, 50, 50),
            ["Бордовый"] = Color3.fromRGB(150, 20, 30),
            ["Радужный"] = Color3.fromRGB(255, 255, 255),
            ["Оранжевый"] = Color3.fromRGB(255, 150, 50),
            ["Белый"] = Color3.fromRGB(255, 255, 255),
            ["Чёрный"] = Color3.fromRGB(18, 20, 22)
        }
        local textColor = {
            ["Синий"] = Color3.fromRGB(0,0,0),
            ["Розовый"] = Color3.fromRGB(0,0,0),
            ["Фиолетовый"] = Color3.fromRGB(0,0,0),
            ["Красный"] = Color3.fromRGB(0,0,0),
            ["Бордовый"] = Color3.fromRGB(0,0,0),
            ["Радужный"] = Color3.fromRGB(0,0,0),
            ["Оранжевый"] = Color3.fromRGB(0,0,0),
            ["Белый"] = Color3.fromRGB(0,0,0),
            ["Чёрный"] = Color3.fromRGB(255,255,255)
        }
        
        local function applyTheme(name)
            local bg = themeColors[name] or Color3.fromRGB(18,20,22)
            local txt = textColor[name] or Color3.fromRGB(255,255,255)
            MFrame.BackgroundColor3 = bg
            MTitle.TextColor3 = txt
            TgLabel.TextColor3 = txt
            ThemeLabel.TextColor3 = txt
            for _, btn in ipairs(btns) do btn.TextColor3 = txt end
            for _, c in ipairs(containers) do
                for _, child in ipairs(c:GetChildren()) do
                    if child:IsA("TextLabel") then child.TextColor3 = txt end
                end
            end
        end
        
        for i, theme in ipairs(themes) do
            local btn = Instance.new("TextButton")
            btn.Parent = ThemeList
            btn.Size = UDim2.new(0, 100, 0, 30)
            btn.Position = UDim2.new((i-1)%3 * 0.34, 5, math.floor((i-1)/3) * 0.25, 5)
            btn.BackgroundColor3 = themeColors[theme]
            btn.Text = theme
            btn.TextColor3 = textColor[theme] or Color3.fromRGB(255,255,255)
            btn.TextSize = 10
            btn.Font = Enum.Font.GothamBold
            btn.MouseButton1Click:Connect(function()
                applyTheme(theme)
                ThemeList.Visible = false
            end)
        end
        
        local ThemeToggle = Instance.new("TextButton")
        ThemeToggle.Parent = ExtraContainer
        ThemeToggle.Size = UDim2.new(0, 150, 0, 30)
        ThemeToggle.Position = UDim2.new(0.5, -75, 0, 100)
        ThemeToggle.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        ThemeToggle.Text = "Открыть темы"
        ThemeToggle.TextColor3 = Color3.fromRGB(255, 255, 255)
        ThemeToggle.TextSize = 12
        ThemeToggle.Font = Enum.Font.GothamBold
        ThemeToggle.MouseButton1Click:Connect(function()
            ThemeList.Visible = not ThemeList.Visible
        end)
        
        -- =================== ПОДВАЛ ===================
        local Footer = Instance.new("TextLabel")
        Footer.Parent = MFrame
        Footer.Size = UDim2.new(1, 0, 0, 30)
        Footer.Position = UDim2.new(0, 0, 1, -30)
        Footer.BackgroundTransparency = 1
        Footer.Text = "made by @MegaCoderRbx"
        Footer.TextColor3 = Color3.fromRGB(90, 90, 90)
        Footer.TextSize = 10
        Footer.Font = Enum.Font.Gotham
        
        print("Загрузка завершена. Меню открыто.")
    end)
end
