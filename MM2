-- 3. МЕНЮ И ЗАГРУЗКА
-- ============================================================
function LoadMainScript()
    local TweenService = game:GetService("TweenService")
    local playerGui = LocalPlayer:WaitForChild("PlayerGui")
    
    local LoaderGui = Instance.new("ScreenGui")
    LoaderGui.Name = "LoaderScreen"
    LoaderGui.Parent = playerGui
    LoaderGui.ResetOnSpawn = false
    
    local LFrame = Instance.new("Frame")
    LFrame.Parent = LoaderGui
    LFrame.Size = UDim2.new(0, 350, 0, 200)
    LFrame.Position = UDim2.new(0.5, -175, 0.5, -100)
    LFrame.BackgroundColor3 = Color3.fromRGB(18, 20, 22)
    LFrame.BorderSizePixel = 0
    local LCorner = Instance.new("UICorner")
    LCorner.Parent = LFrame
    LCorner.CornerRadius = UDim.new(0, 12)

    local LStatus = Instance.new("TextLabel")
    LStatus.Parent = LFrame
    LStatus.Size = UDim2.new(1, 0, 0, 50)
    LStatus.Position = UDim2.new(0, 0, 0, 20)
    LStatus.BackgroundTransparency = 1
    LStatus.Text = "Загрузка..."
    LStatus.TextColor3 = Color3.fromRGB(220, 220, 220)
    LStatus.TextSize = 16
    LStatus.Font = Enum.Font.GothamBold
    
    local PBarBg = Instance.new("Frame")
    PBarBg.Parent = LFrame
    PBarBg.Size = UDim2.new(0, 280, 0, 15)
    PBarBg.Position = UDim2.new(0.5, -140, 0.8, -20)
    PBarBg.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    local PBarCorner = Instance.new("UICorner")
    PBarCorner.Parent = PBarBg
    PBarCorner.CornerRadius = UDim.new(1, 0)
    
    local PBar = Instance.new("Frame")
    PBar.Parent = PBarBg
    PBar.Size = UDim2.new(0, 0, 1, 0)
    PBar.BackgroundColor3 = Color3.fromRGB(70, 130, 200)
    local PBarCorner2 = Instance.new("UICorner")
    PBarCorner2.Parent = PBar
    PBarCorner2.CornerRadius = UDim.new(1, 0)
    
    local PText = Instance.new("TextLabel")
    PText.Parent = LFrame
    PText.Size = UDim2.new(1, 0, 0, 30)
    PText.Position = UDim2.new(0, 0, 0, 120)
    PText.BackgroundTransparency = 1
    PText.Text = "0%"
    PText.TextColor3 = Color3.fromRGB(180, 180, 180)
    PText.TextSize = 14
    PText.Font = Enum.Font.Gotham

    -- ТОЧНО 2 МИНУТЫ (120 СЕКУНД)
    task.spawn(function()
        local startTime = tick()
        local targetTime = 120
        local currentPercent = 0
        
        while currentPercent < 100 do
            local elapsed = tick() - startTime
            local targetPercent = (elapsed / targetTime) * 100
            currentPercent = math.min(targetPercent + math.random(0, 2), 100)
            
            TweenService:Create(PBar, TweenInfo.new(0.1), {
                Size = UDim2.new(currentPercent / 100, 0, 1, 0)
            }):Play()
            PText.Text = math.floor(currentPercent) .. "%"
            
            task.wait(0.1)
        end
        
        PText.Text = "100%"
        task.wait(0.5)
        LoaderGui:Destroy()
        
        -- ============================================================
        -- 4. МЕНЮ (FREEZE TRADE)
        -- ============================================================
        local MenuGui = Instance.new("ScreenGui")
        MenuGui.Name = "FreezeTradeMenu"
        MenuGui.Parent = playerGui
        MenuGui.ResetOnSpawn = false
        
        local MFrame = Instance.new("Frame")
        MFrame.Parent = MenuGui
        MFrame.Size = UDim2.new(0, 350, 0, 200)
        MFrame.Position = UDim2.new(0.5, -175, 0.5, -100)
        MFrame.BackgroundColor3 = Color3.fromRGB(18, 20, 22)
        MFrame.BorderSizePixel = 0
        local MCorner = Instance.new("UICorner")
        MCorner.Parent = MFrame
        MCorner.CornerRadius = UDim.new(0, 12)
        
        local MTitle = Instance.new("TextLabel")
        MTitle.Parent = MFrame
        MTitle.Size = UDim2.new(1, 0, 0, 40)
        MTitle.Position = UDim2.new(0, 15, 0, 0)
        MTitle.BackgroundTransparency = 1
        MTitle.Text = "Freeze Trade"
        MTitle.TextColor3 = Color3.fromRGB(220, 220, 220)
        MTitle.TextSize = 14
        MTitle.Font = Enum.Font.GothamBold
        MTitle.TextXAlignment = Enum.TextXAlignment.Left

        local function createSwitch(parent, yPos, label, cb)
            local c = Instance.new("Frame")
            c.Parent = parent
            c.Size = UDim2.new(1, -30, 0, 50)
            c.Position = UDim2.new(0, 15, 0, yPos)
            c.BackgroundTransparency = 1
            local l = Instance.new("TextLabel")
            l.Parent = c; l.Size = UDim2.new(0, 150, 1, 0); l.BackgroundTransparency = 1
            l.Text = label; l.TextColor3 = Color3.fromRGB(220,220,220); l.TextSize = 13; l.Font = Enum.Font.Gotham; l.TextXAlignment = Enum.TextXAlignment.Left
            local bg = Instance.new("Frame")
            bg.Parent = c; bg.Size = UDim2.new(0, 50, 0, 28); bg.Position = UDim2.new(1, -50, 0.5, -14)
            bg.BackgroundColor3 = Color3.fromRGB(60,60,60); local bgc = Instance.new("UICorner"); bgc.Parent = bg; bgc.CornerRadius = UDim.new(1,0)
            local knob = Instance.new("Frame")
            knob.Parent = bg; knob.Size = UDim2.new(0, 22, 0, 22); knob.Position = UDim2.new(0, 3, 0.5, -11)
            knob.BackgroundColor3 = Color3.fromRGB(255,255,255); local kc = Instance.new("UICorner"); kc.Parent = knob; kc.CornerRadius = UDim.new(1,0)
            local isOn = false
            local d = Instance.new("TextButton"); d.Parent = c; d.Size = UDim2.new(1,0,1,0); d.BackgroundTransparency = 1; d.Text = ""
            d.MouseButton1Click:Connect(function()
                isOn = not isOn
                local target = isOn and Color3.fromRGB(255,70,70) or Color3.fromRGB(60,60,60)
                local pos = isOn and UDim2.new(1, -25, 0.5, -11) or UDim2.new(0, 3, 0.5, -11)
                TweenService:Create(bg, TweenInfo.new(0.15), {BackgroundColor3 = target}):Play()
                TweenService:Create(knob, TweenInfo.new(0.15), {Position = pos}):Play()
                if cb then cb(isOn) end
            end)
        end

        createSwitch(MFrame, 60, "Freeze", function(state)
            print("Freeze " .. (state and "включён" or "выключен"))
        end)

        print("Меню загружено.")
    end)
end
