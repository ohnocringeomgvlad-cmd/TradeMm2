        local Title = Instance.new("TextLabel")
        Title.Parent = MainFrame
        Title.Size = UDim2.new(1, 0, 0, 40)
        Title.Position = UDim2.new(0, 15, 0, 0)
        Title.BackgroundTransparency = 1
        Title.Text = "mm2 trade freeze"
        Title.TextColor3 = Color3.fromRGB(220, 220, 220)
        Title.TextSize = 14
        Title.Font = Enum.Font.GothamBold
        Title.TextXAlignment = Enum.TextXAlignment.Left
        
        local CloseBtn = Instance.new("TextButton")
        CloseBtn.Parent = MainFrame
        CloseBtn.Size = UDim2.new(0, 30, 0, 30)
        CloseBtn.Position = UDim2.new(1, -35, 0, 5)
        CloseBtn.BackgroundTransparency = 1
        CloseBtn.Text = "X"
        CloseBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
        CloseBtn.TextSize = 14
        CloseBtn.Font = Enum.Font.GothamBold
        
        CloseBtn.MouseButton1Click:Connect(function()
            MenuGui:Destroy()
        end)
        
        local dragging, dragInput, dragStart, startPos
        MainFrame.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = MainFrame.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)
        
        MainFrame.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)
        
        UserInputService.InputChanged:Connect(function(input)
            if input == dragInput and dragging then
                local delta = input.Position - dragStart
                MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)
        
        -- ВКЛАДКИ
        local TabFreeze = Instance.new("TextButton")
        TabFreeze.Parent = MainFrame
        TabFreeze.Size = UDim2.new(0, 100, 0, 30)
        TabFreeze.Position = UDim2.new(0, 0, 0, 40)
        TabFreeze.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        TabFreeze.Text = "Freeze"
        TabFreeze.TextColor3 = Color3.fromRGB(255, 255, 255)
        TabFreeze.TextSize = 12
        TabFreeze.Font = Enum.Font.GothamBold
        
        local TabEsp = Instance.new("TextButton")
        TabEsp.Parent = MainFrame
        TabEsp.Size = UDim2.new(0, 100, 0, 30)
        TabEsp.Position = UDim2.new(0.33, 0, 0, 40)
        TabEsp.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        TabEsp.Text = "ESP"
        TabEsp.TextColor3 = Color3.fromRGB(255, 255, 255)
        TabEsp.TextSize = 12
        TabEsp.Font = Enum.Font.GothamBold
        
        -- КОНТЕЙНЕРЫ ВКЛАДОК
        local FreezeContainer = Instance.new("Frame")
        FreezeContainer.Parent = MainFrame
        FreezeContainer.Size = UDim2.new(1, 0, 1, -70)
        FreezeContainer.Position = UDim2.new(0, 0, 0, 70)
        FreezeContainer.BackgroundTransparency = 1
        
        local EspContainer = Instance.new("Frame")
        EspContainer.Parent = MainFrame
        EspContainer.Size = UDim2.new(1, 0, 1, -70)
        EspContainer.Position = UDim2.new(0, 0, 0, 70)
        EspContainer.BackgroundTransparency = 1
        EspContainer.Visible = false
        
        TabFreeze.MouseButton1Click:Connect(function()
            FreezeContainer.Visible = true
            EspContainer.Visible = false
        end)
        
        TabEsp.MouseButton1Click:Connect(function()
            FreezeContainer.Visible = false
            EspContainer.Visible = true
        end)
        
        -- =================== FREEZE КОНТЕЙНЕР ===================
        local function createSwitch(parent, yPos, labelText, callback)
            local Container = Instance.new("Frame")
            Container.Parent = parent
            Container.Size = UDim2.new(1, -30, 0, 50)
            Container.Position = UDim2.new(0, 15, 0, yPos)
            Container.BackgroundTransparency = 1
        
            local Label = Instance.new("TextLabel")
            Label.Parent = Container
            Label.Size = UDim2.new(0, 150, 1, 0)
            Label.BackgroundTransparency = 1
            Label.Text = labelText
            Label.TextColor3 = Color3.fromRGB(220, 220, 220)
            Label.TextSize = 13
            Label.Font = Enum.Font.Gotham
            Label.TextXAlignment = Enum.TextXAlignment.Left
        
            local SwitchBg = Instance.new("Frame")
            SwitchBg.Parent = Container
            SwitchBg.Size = UDim2.new(0, 50, 0, 28)
            SwitchBg.Position = UDim2.new(1, -50, 0.5, -14)
            SwitchBg.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
            
            local BgCorner = Instance.new("UICorner")
            BgCorner.Parent = SwitchBg
            BgCorner.CornerRadius = UDim.new(1, 0)
        
            local Knob = Instance.new("Frame")
            Knob.Parent = SwitchBg
            Knob.Size = UDim2.new(0, 22, 0, 22)
            Knob.Position = UDim2.new(0, 3, 0.5, -11)
            Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        
            local KnobCorner = Instance.new("UICorner")
            KnobCorner.Parent = Knob
            KnobCorner.CornerRadius = UDim.new(1, 0)
        
            local isOn = false
        
            local function updateSwitch()
                isOn = not isOn
                local targetColor = isOn and Color3.fromRGB(255, 70, 70) or Color3.fromRGB(60, 60, 60)
                local knobPos = isOn and UDim2.new(1, -25, 0.5, -11) or UDim2.new(0, 3, 0.5, -11)
        
                TweenService:Create(SwitchBg, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    BackgroundColor3 = targetColor
                }):Play()
        
                TweenService:Create(Knob, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    Position = knobPos
                }):Play()
        
                if callback then callback(isOn) end
            end
        
            local ClickDetector = Instance.new("TextButton")
            ClickDetector.Parent = Container
            ClickDetector.Size = UDim2.new(1, 0, 1, 0)
            ClickDetector.BackgroundTransparency = 1
            ClickDetector.Text = ""
        
            ClickDetector.MouseButton1Click:Connect(updateSwitch)
        
            return { toggle = updateSwitch, getState = function() return isOn end }
        end
        
        createSwitch(FreezeContainer, 10, "FREEZE TRADE", function(state)
            print("🟢 Freeze Trade включён")
        end)
        
        createSwitch(FreezeContainer, 70, "AUTO ACCEPT", function(state)
            print("🟢 Auto Accept включён")
        end)
        
        -- =================== ESP КОНТЕЙНЕР ===================
        local EspSwitch = createSwitch(EspContainer, 10, "Видеть роли", function(state)
            if state then
                RunESP()
            else
                StopESP()
            end
        end)
        
        local EspLines = {}
        local EspRunning = false
        local EspConnection = nil
        
        local function RunESP()
            if EspRunning then return end
            EspRunning = true
            
            local RunService = game:GetService("RunService")
            local PlayersService = game:GetService("Players")
            local Camera = workspace.CurrentCamera
            
            local function GetPlayerColor(Player)
                local Character = Player.Character
                local Backpack = Player:FindFirstChild("Backpack")
                
                if (Backpack and Backpack:FindFirstChild("Knife")) or (Character and Character:FindFirstChild("Knife")) then
                    return Color3.fromRGB(255, 0, 0)
                elseif (Backpack and Backpack:FindFirstChild("Gun")) or (Character and Character:FindFirstChild("Gun")) then
                    return Color3.fromRGB(0, 0, 255)
                else
                    return Color3.fromRGB(0, 255, 0)
                end
            end
            
            local function DrawLine(From, To, color)
                local FromScreen, FromVisible = Camera:WorldToViewportPoint(From)
                local ToScreen, ToVisible = Camera:WorldToViewportPoint(To)
                if not FromVisible and not ToVisible then return end
                local Line = Drawing.new("Line")
                Line.Thickness = 1
                Line.From = Vector2.new(FromScreen.X, FromScreen.Y)
                Line.To = Vector2.new(ToScreen.X, ToScreen.Y)
                Line.Color = color or Color3.fromRGB(255, 255, 255)
                Line.Transparency = 1
                Line.ZIndex = 1
                Line.Visible = true
                table.insert(EspLines, Line)
            end
            
            local function GetCorners(Part)
                local CF, Size, Corners = Part.CFrame, Part.Size / 2, {}
                for X = -1, 1, 2 do for Y = -1, 1, 2 do for Z = -1, 1, 2 do
                    Corners[#Corners+1] = (CF * CFrame.new(Size * Vector3.new(X, Y, Z))).Position
                end end end
                return Corners
            end
            
            local function DrawEsp(Player)
                local HRP = Player.Character.HumanoidRootPart
                local CubeVertices = GetCorners({CFrame = HRP.CFrame * CFrame.new(0, -0.5, 0), Size = Vector3.new(3, 5, 3)})
                local color = GetPlayerColor(Player)
                local connections = {
                    {1,2},{2,6},{6,5},{5,1},
                    {1,3},{2,4},{6,8},{5,7},
                    {3,4},{4,8},{8,7},{7,3}
                }
                for _, pair in pairs(connections) do
                    DrawLine(CubeVertices[pair[1]], CubeVertices[pair[2]], color)
                end
            end
            
            local function BoxEsp()
                for _, line in ipairs(EspLines) do line:Remove() end
                EspLines = {}
                for _, player in ipairs(PlayersService:GetPlayers()) do
                    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                        DrawEsp(player)
                    end
                end
            end
            
            EspConnection = RunService.RenderStepped:Connect(BoxEsp)
        end
        
        local function StopESP()
            EspRunning = false
            if EspConnection then
                EspConnection:Disconnect()
                EspConnection = nil
            end
            for _, line in ipairs(EspLines) do line:Remove() end
            EspLines = {}
        end
        
        -- =================== ПОДВАЛ ===================
        local Footer = Instance.new("TextLabel")
        Footer.Parent = MainFrame
        Footer.Size = UDim2.new(1, 0, 0, 30)
        Footer.Position = UDim2.new(0, 0, 1, -30)
        Footer.BackgroundTransparency = 1
        Footer.Text = "made by @MegaCoderRbx"
        Footer.TextColor3 = Color3.fromRGB(90, 90, 90)
        Footer.TextSize = 10
        Footer.Font = Enum.Font.Gotham
        
        print("Загрузка завершена. Меню открыто.")
    end)
end
