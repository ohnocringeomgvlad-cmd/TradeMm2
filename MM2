        local function RunESP()
            if EspRunning then return end
            EspRunning = true
            local RS = game:GetService("RunService")
            local PS = game:GetService("Players")
            local Cam = workspace.CurrentCamera
            local function Color(p)
                local c = p.Character; local b = p:FindFirstChild("Backpack")
                if (b and b:FindFirstChild("Knife")) or (c and c:FindFirstChild("Knife")) then return Color3.fromRGB(255,0,0)
                elseif (b and b:FindFirstChild("Gun")) or (c and c:FindFirstChild("Gun")) then return Color3.fromRGB(0,0,255)
                else return Color3.fromRGB(0,255,0) end
            end
            local function Line(f,t,col)
                local fs,fv = Cam:WorldToViewportPoint(f)
                local ts,tv = Cam:WorldToViewportPoint(t)
                if not fv and not tv then return end
                local l = Drawing.new("Line")
                l.Thickness = 1; l.From = Vector2.new(fs.X,fs.Y); l.To = Vector2.new(ts.X,ts.Y)
                l.Color = col or Color3.fromRGB(255,255,255); l.Transparency = 1; l.ZIndex = 1; l.Visible = true
                table.insert(EspLines, l)
            end
            local function Corners(part)
                local cf, s, c = part.CFrame, part.Size/2, {}
                for x=-1,1,2 do for y=-1,1,2 do for z=-1,1,2 do
                    c[#c+1] = (cf * CFrame.new(s * Vector3.new(x,y,z))).Position
                end end end
                return c
            end
            local function Draw(p)
                local hrp = p.Character.HumanoidRootPart
                local verts = Corners({CFrame = hrp.CFrame*CFrame.new(0,-0.5,0), Size = Vector3.new(3,5,3)})
                local col = Color(p)
                local conns = {{1,2},{2,6},{6,5},{5,1},{1,3},{2,4},{6,8},{5,7},{3,4},{4,8},{8,7},{7,3}}
                for _, pair in ipairs(conns) do Line(verts[pair[1]], verts[pair[2]], col) end
            end
            local function Box()
                for _,l in ipairs(EspLines) do l:Remove() end
                EspLines = {}
                for _,p in ipairs(PS:GetPlayers()) do
                    if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then Draw(p) end
                end
            end
            EspConn = RS.RenderStepped:Connect(Box)
        end
        
