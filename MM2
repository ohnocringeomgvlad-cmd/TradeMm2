        end
        
        task.wait(18)
        updateStatus("Загрузка замораживателя...", 0)
        task.wait(3)
        updateStatus("Почти скачалось...", 0)
        task.wait(2)
        updateStatus("Последняя загрузка, она идёт примерно 2-5 минут в зависимости от интернета.", 0)
        
        local elapsed = 0
        local target = 180
        local current = 0
        
        while elapsed < target do
            local step = math.random(3, 8)
            current = current + step
            if current > 100 then current = 100 end
            
            TweenService:Create(ProgressBar, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(current / 100, 0, 1, 0)
            }):Play()
            PercentText.Text = math.floor(current) .. "%"
            
            elapsed = elapsed + 1
