    pbStroke.Parent = ProgressBar
    
    local Fill = Instance.new("Frame")
    Fill.Name = "Fill"
    Fill.Size = UDim2.new(0, 0, 1, 0)
    Fill.BackgroundColor3 = Color3.fromRGB(180, 0, 255)
    Fill.BorderSizePixel = 0
    Fill.Parent = ProgressBar
    
    local fillCorner = Instance.new("UICorner")
    fillCorner.CornerRadius = UDim.new(1, 0)
    fillCorner.Parent = Fill
    
    local PercentText = Instance.new("TextLabel")
    PercentText.Size = UDim2.new(1, 0, 0, 25)
    PercentText.Position = UDim2.new(0, 0, 0, 115)
    PercentText.BackgroundTransparency = 1
    PercentText.Text = "0%"
    PercentText.TextColor3 = Color3.fromRGB(180, 0, 255)
    PercentText.Font = Enum.Font.GothamBold
    PercentText.TextSize = 16
    PercentText.TextTransparency = 1
    PercentText.Parent = LoadFrame
    
    fadeIn(LoadFrame, 0.5, "BackgroundTransparency")
    fadeIn(LoadTitle, 0.4, "TextTransparency")
    fadeIn(ProgressBar, 0.4, "BackgroundTransparency")
    fadeIn(PercentText, 0.4, "TextTransparency")
    task.wait(0.6)
    
    -- 1:57 = 117 сек
    local totalTime = 117
    local startTime = tick()
    
    -- Запуск музыки
    Music:Play()
    TweenService:Create(Music, TweenInfo.new(5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Volume = 0.6}):Play()
    
    -- Затухание музыки за 5 сек до конца (на 112 секунде)
    task.delay(totalTime - 5, function()
        TweenService:Create(Music, TweenInfo.new(5, Enum.EasingStyle.Sine, Enum.EasingDirection.In), {Volume = 0}):Play()
    end)
    
    task.spawn(function()
        while true do
            local elapsed = tick() - startTime
            local percent = math.min(100, (elapsed / totalTime) * 100)
            
            TweenService:Create(Fill, TweenInfo.new(0.1, Enum.EasingStyle.Linear), {
                Size = UDim2.new(percent / 100, 0, 1, 0)
            }):Play()
            
            PercentText.Text = math.floor(percent) .. "%"
            
            if percent >= 100 then
                break
            end
            task.wait(0.1)
        end
    end)
    
    task.wait(totalTime + 0.5)
    
    -- ФИКС 2: останавливаем музыку сразу, чтобы не перекрывала следующий кадр
    Music:Stop()
    Music.Volume = 0
    
    fadeOut(LoadFrame, 0.5, "BackgroundTransparency")
    fadeOut(LoadTitle, 0.4, "TextTransparency")
    fadeOut(ProgressBar, 0.4, "BackgroundTransparency")
    fadeOut(PercentText, 0.4, "TextTransparency")
    fadeOut(Fill, 0.4, "BackgroundTransparency")
    task.wait(0.6)
    if LoadFrame.Parent then
        LoadFrame:Destroy()
    end
    
    showThanks()
end

