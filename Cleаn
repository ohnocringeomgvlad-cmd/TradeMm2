        Label.TextColor3 = Color3.fromRGB(220, 220, 230)
        Label.Font = Enum.Font.GothamBold
        Label.TextSize = 15
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.TextTransparency = 1
        Label.Parent = ToggleFrame
        
        local ToggleButton = Instance.new("TextButton")
        ToggleButton.Name = "Toggle"
        ToggleButton.Size = UDim2.new(0, 50, 0, 26)
        ToggleButton.Position = UDim2.new(1, -65, 0.5, -13)
        ToggleButton.BackgroundColor3 = defaultState and Color3.fromRGB(180, 0, 255) or Color3.fromRGB(60, 60, 70)
        ToggleButton.BorderSizePixel = 0
        ToggleButton.Text = ""
        ToggleButton.AutoButtonColor = false
        ToggleButton.Parent = ToggleFrame
        
        local tbCorner = Instance.new("UICorner")
        tbCorner.CornerRadius = UDim.new(1, 0)
        tbCorner.Parent = ToggleButton
        
        local Knob = Instance.new("Frame")
        Knob.Name = "Knob"
        Knob.Size = UDim2.new(0, 20, 0, 20)
        Knob.Position = defaultState and UDim2.new(1, -23, 0.5, -10) or UDim2.new(0, 3, 0.5, -10)
        Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        Knob.BorderSizePixel = 0
        Knob.Parent = ToggleButton
        
        local kCorner = Instance.new("UICorner")
        kCorner.CornerRadius = UDim.new(1, 0)
        kCorner.Parent = Knob
        
        local state = defaultState
        
        ToggleButton.MouseButton1Click:Connect(function()
            state = not state
            local bgColor = state and Color3.fromRGB(180, 0, 255) or Color3.fromRGB(60, 60, 70)
            local knobPos = state and UDim2.new(1, -23, 0.5, -10) or UDim2.new(0, 3, 0.5, -10)
            
            TweenService:Create(ToggleButton, TweenInfo.new(0.25, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {BackgroundColor3 = bgColor}):Play()
            TweenService:Create(Knob, TweenInfo.new(0.25, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Position = knobPos}):Play()
            
            if state then
                if name == "Freeze Trade" then
                    print("[Mertily] Freeze Trade активирован")
                elseif name == "Force accept trade" then
                    print("[Mertily] Force accept trade активирован")
                end
            end
        end)
        
        return ToggleFrame, Label
    end
    
    local FreezeFrame, FreezeLabel = createToggle("Freeze Trade", 95, false)
    local ForceFrame, ForceLabel = createToggle("Force accept trade", 170, false)
    
    fadeIn(MainFrame, 0.6, "BackgroundTransparency")
    fadeIn(MainHandle, 0.5, "TextTransparency")
    fadeIn(MainHandle, 0.5, "BackgroundTransparency")
    fadeIn(CloseBtn, 0.5, "TextTransparency")
    fadeIn(MainTitle, 0.5, "TextTransparency")
    
    task.wait(0.2)
    fadeIn(FreezeFrame, 0.4, "BackgroundTransparency")
    fadeIn(FreezeLabel, 0.4, "TextTransparency")
    
    task.wait(0.1)
    fadeIn(ForceFrame, 0.4, "BackgroundTransparency")
    fadeIn(ForceLabel, 0.4, "TextTransparency")
end
