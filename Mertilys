-- ===================================================================
-- CORE UTILITIES & ANIMATIONS
-- ===================================================================
b["a.b"] = (function()
    local TweenService = game:GetService("TweenService")
    local UserInputService = game:GetService("UserInputService")
    local RunService = game:GetService("RunService")

    local m = {}
    local theme = b["a.a"]

    function m.New(className, properties, children)
        local inst = Instance.new(className)
        for k, v in pairs(properties or {}) do
            if k ~= "ThemeTag" then
                inst[k] = v
            end
        end
        for _, child in ipairs(children or {}) do
            child.Parent = inst
        end
        return inst
    end

    function m.NewRoundFrame(radius, color)
        local frame = Instance.new("Frame")
        frame.BackgroundColor3 = color or theme.Dialog
        frame.BorderSizePixel = 0
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, radius or 8)
        corner.Parent = frame
        return frame
    end

    function m.Tween(inst, info, props)
        local tween = TweenService:Create(inst, info, props)
        tween:Play()
        return tween
    end

    function m.Drag(dragHandle, targetWindow)
        local dragging, dragInput, dragStart, startPos
        dragHandle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = targetWindow.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)
        dragHandle.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if input == dragInput and dragging then
                local delta = input.Position - dragStart
                m.Tween(targetWindow, TweenInfo.new(0.08, Enum.EasingStyle.Sine), {
                    Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
                })
            end
        end)
    end

    return m
end)()

