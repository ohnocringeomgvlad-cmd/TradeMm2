        local stroke = Instance.new("UIStroke")
        stroke.Color = theme.Border
        stroke.Thickness = 1.5
        stroke.Parent = windowFrame

        local topBar = utils.New("Frame", {
            Size = UDim2.new(1, 0, 0, 40),
