-- Вспомогательные функции поиска ролей
function Modules.FindMurderer()
    for _, plr in ipairs(Players:GetPlayers()) do
        if (plr:FindFirstChild("Backpack") and plr.Backpack:FindFirstChild("Knife")) or (plr.Character and plr.Character:FindFirstChild("Knife")) then
            return plr
        end
    end
    return nil
end

function Modules.FindSheriff()
    for _, plr in ipairs(Players:GetPlayers()) do
        if (plr:FindFirstChild("Backpack") and plr.Backpack:FindFirstChild("Gun")) or (plr.Character and plr.Character:FindFirstChild("Gun")) then
            return plr
        end
    end
    return nil
end

-- ========================================================
--  ФУНКЦИОНАЛ ESP (ВХ)
-- ========================================================
local function UpdateESPState()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= Modules.Player and plr.Character then
            local espColor = Color3.fromRGB(0, 255, 0)
            local espRole = "Innocent"

            if Modules.FindMurderer() == plr then
                espColor = Color3.fromRGB(255, 0, 0)
                espRole = "Murderer"
            elseif Modules.FindSheriff() == plr then
                espColor = Color3.fromRGB(0, 0, 255)
                espRole = "Sheriff"
            end

            local char = plr.Character
            if Modules.Config.EspPlayers then
                local hl = char:FindFirstChild("VisionHighlight") or Instance.new("Highlight", char)
                hl.Name = "VisionHighlight"
                hl.FillTransparency = 0.85
                hl.OutlineTransparency = 0
                hl.FillColor = espColor
                hl.OutlineColor = espColor
                hl.Enabled = true
            else
                if char:FindFirstChild("VisionHighlight") then char.VisionHighlight:Destroy() end
            end

            if Modules.Config.ShowNames then
                local head = char:FindFirstChild("Head")
                if head then
                    local bg = head:FindFirstChild("NameESP") or Instance.new("BillboardGui", head)
                    bg.Name = "NameESP"
                    bg.Size = UDim2.new(0, 200, 0, 50)
                    bg.StudsOffset = Vector3.new(0, 3, 0)
                    bg.AlwaysOnTop = true
                    
                    local label = bg:FindFirstChild("TextLabel") or Instance.new("TextLabel", bg)
                    label.Size = UDim2.new(1, 0, 1, 0)
                    label.BackgroundTransparency = 1
                    label.Font = Enum.Font.SourceSansBold
                    label.TextSize = 16
                    label.TextColor3 = espColor
                    
                    local dist = Modules.RootPart and math.floor((Modules.RootPart.Position - head.Position).Magnitude) or 0
                    label.Text = string.format("%s\n[%s] [%d m]", plr.Name, espRole, dist)
                end
            else
                if char:FindFirstChild("Head") and char.Head:FindFirstChild("NameESP") then
                    char.Head.NameESP:Destroy()
                end
            end
        end
    end
end

RunService.RenderStepped:Connect(function()
    if Modules.Config.EspPlayers or Modules.Config.ShowNames then
        UpdateESPState()
    end
end)

