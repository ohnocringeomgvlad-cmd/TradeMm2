-- Анимация падения листиков
local function spawnLeaf()
    local leaf = Instance.new("Frame")
    leaf.Size = UDim2.new(0, math.random(6, 12), 0, math.random(10, 16))
    leaf.Position = UDim2.new(math.random(0, 95) / 100, 0, -0.1, 0)
    leaf.BackgroundColor3 = THEME.RoseLeaf
    leaf.BackgroundTransparency = 0.3
    leaf.Rotation = math.random(0, 180)
    leaf.ZIndex = 2
    leaf.Parent = bgPatternFrame

    createCorner(leaf, 6)

    local fallDuration = math.random(5, 8)
    local startX = leaf.Position.X.Scale
    local swayAmount = math.random(3, 8) / 100

    local tweenFall = TweenService:Create(leaf, TweenInfo.new(fallDuration, Enum.EasingStyle.Linear), {
        Position = UDim2.new(startX, 0, 1.1, 0),
        Rotation = leaf.Rotation + 180
    })
    tweenFall:Play()

    task.spawn(function()
        local startTime = tick()
        while tick() - startTime < fallDuration and leaf.Parent do
            local elapsed = tick() - startTime
            local sway = math.sin(elapsed * 3) * swayAmount
            leaf.Position = UDim2.new(startX + sway, 0, leaf.Position.Y.Scale, leaf.Position.Y.Offset)
            task.wait(0.03)
        end
    end)

    tweenFall.Completed:Connect(function()
        leaf:Destroy()
    end)
end

task.spawn(function()
    while true do
        if mainWindow.Visible then
            spawnLeaf()
        end
        task.wait(0.7)
    end
end)

