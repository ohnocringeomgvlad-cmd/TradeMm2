            BorderSizePixel = 0,
            Parent = windowFrame
        })

        local titleLabel = utils.New("TextLabel", {
            Size = UDim2.new(1, -20, 1, 0),
            Position = UDim2.new(0, 15, 0, 0),
            BackgroundTransparency = 1,
            Text = config.Title or "WindUI Window",
            TextColor3 = theme.Text,
            TextSize = 15,
            Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = topBar
        })

        utils.Drag(topBar, windowFrame)

        local sidebar = utils.New("Frame", {
            Size = UDim2.new(0, 140, 1, -40),
            Position = UDim2.new(0, 0, 0, 40),
            BackgroundColor3 = theme.Dialog,
            BorderSizePixel = 0,
            Parent = windowFrame
        })

        local tabList = utils.New("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 6),
            Parent = sidebar
        })

        local tabPadding = utils.New("UIPadding", {
            PaddingTop = UDim.new(0, 10),
            PaddingLeft = UDim.new(0, 8),
            PaddingRight = UDim.new(0, 8),
            Parent = sidebar
        })

        local container = utils.New("Frame", {
            Size = UDim2.new(1, -150, 1, -50),
            Position = UDim2.new(0, 145, 0, 45),
            BackgroundTransparency = 1,
            Parent = windowFrame
        })

        local activeTab = nil

        return {
            Gui = gui,
            Notify = b["a.d"].Notify,
            
            AddTab = function(self, tabName)
                local tabBtn = utils.NewRoundFrame(6, theme.Dialog)
                tabBtn.Size = UDim2.new(1, 0, 0, 32)
                tabBtn.Parent = sidebar

                local btnText = utils.New("TextLabel", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text = tabName,
                    TextColor3 = theme.SubText,
                    TextSize = 13,
                    Font = Enum.Font.GothamSemibold,
                    Parent = tabBtn
                })

                local trigger = utils.New("TextButton", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text = "",
                    Parent = tabBtn
                })

                local page = utils.New("ScrollingFrame", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    ScrollBarThickness = 3,
                    ScrollBarImageColor3 = theme.Accent,
                    Visible = false,
                    Parent = container
                })

                local pageList = utils.New("UIListLayout", {
                    SortOrder = Enum.SortOrder.LayoutOrder,
                    Padding = UDim.new(0, 8),
                    Parent = page
                })

                trigger.MouseButton1Click:Connect(function()
                    for _, child in ipairs(container:GetChildren()) do
                        if child:IsA("ScrollingFrame") then child.Visible = false end
                    end
                    for _, child in ipairs(sidebar:GetChildren()) do
                        if child:IsA("Frame") then 
                            child.BackgroundColor3 = theme.Dialog
                            local txt = child:FindFirstChildOfClass("TextLabel")
                            if txt then txt.TextColor3 = theme.SubText end
                        end
                    end
                    page.Visible = true
                    tabBtn.BackgroundColor3 = theme.Accent
                    btnText.TextColor3 = theme.White
                end)

                if not activeTab then
                    activeTab = page
                    page.Visible = true
                    tabBtn.BackgroundColor3 = theme.Accent
                    btnText.TextColor3 = theme.White
                end

                local TabAPI = {}

                function TabAPI:AddButton(text, callback)
                    local btn = utils.NewRoundFrame(6, theme.Button)
                    btn.Size = UDim2.new(1, -6, 0, 35)
                    btn.Parent = page

                    local label = utils.New("TextLabel", {
                        Size = UDim2.new(1, 0, 1, 0),
                        BackgroundTransparency = 1,
                        Text = text or "Button",
                        TextColor3 = theme.Text,
                        TextSize = 13,
                        Font = Enum.Font.GothamMedium,
                        Parent = btn
                    })

                    local click = utils.New("TextButton", {
                        Size = UDim2.new(1, 0, 1, 0),
                        BackgroundTransparency = 1,
                        Text = "",
                        Parent = btn
                    })

                    click.MouseButton1Click:Connect(function()
                        if callback then callback() end
                    end)
                end

                function TabAPI:AddToggle(text, default, callback)
                    local state = default or false
                    local card = utils.NewRoundFrame(6, theme.Button)
                    card.Size = UDim2.new(1, -6, 0, 35)
                    card.Parent = page

                    local label = utils.New("TextLabel", {
                        Size = UDim2.new(1, -50, 1, 0),
                        Position = UDim2.new(0, 10, 0, 0),
                        BackgroundTransparency = 1,
                        Text = text or "Toggle",
                        TextColor3 = theme.Text,
                        TextSize = 13,
                        Font = Enum.Font.GothamMedium,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        Parent = card
                    })

                    local box = utils.NewRoundFrame(4, state and theme.Accent or theme.Dialog)
                    box.Size = UDim2.new(0, 20, 0, 20)
                    box.Position = UDim2.new(1, -30, 0.5, -10)
                    box.Parent = card

                    local click = utils.New("TextButton", {
                        Size = UDim2.new(1, 0, 1, 0),
                        BackgroundTransparency = 1,
                        Text = "",
                        Parent = card
                    })

                    click.MouseButton1Click:Connect(function()
                        state = not state
                        box.BackgroundColor3 = state and theme.Accent or theme.Dialog
                        if callback then callback(state) end
                    end)
                end

                return TabAPI
            end
        }
    end
}

