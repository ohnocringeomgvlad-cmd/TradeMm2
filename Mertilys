local function spawnLeaf()
    local leaf = Instance.new("ImageLabel")
    leaf.Size = UDim2.new(0, math.random(14, 22), 0, math.random(14, 22))
    leaf.Position = UDim2.new(math.random(), 0, -0.05, 0)
    leaf.BackgroundTransparency = 1
    leaf.Image = "rbxassetid://6071575925"
    leaf.ImageColor3 = Color3.fromRGB(100, 200, 120)
    leaf.ImageTransparency = math.random(3, 6) / 10
    leaf.ZIndex = 3
    leaf.Parent = leavesContainer

    createCorner(leaf, 10)

    local fallDuration = math.random(8, 14)
    local startX = leaf.Position.X.Scale
    local swayAmount = math.random(3, 8) / 100

    local tweenFall = TweenService:Create(leaf, TweenInfo.new(fallDuration, Enum.EasingStyle.Linear), {
        Position = UDim2.new(startX, 0, 1.05, 0),
        Rotation = math.random(180, 360)
    })
    tweenFall:Play()

    task.spawn(function()
        local startTime = tick()
        while tick() - startTime < fallDuration and leaf.Parent do
            local elapsed = tick() - startTime
            local sway = math.sin(elapsed * 2) * swayAmount
            leaf.Position = UDim2.new(startX + sway, 0, leaf.Position.Y.Scale, leaf.Position.Y.Offset)
            task.wait(0.03)
        end
    end)

    tweenFall.Completed:Connect(function()
        leaf:Destroy()
    end)
end

task.spawn(function()
    while true do
        if mainBackground.Visible then
            spawnLeaf()
        end
