-- === Показ / Скрытие Меню ===
local menuVisible = false

local function toggleMenu()
    menuVisible = not menuVisible
    
    if menuVisible then
        mainMenu.Visible = true
        mainMenu.Size = UDim2.new(0, 280, 0, 0)
        mainMenu.BackgroundTransparency = 0.5
        
        TweenService:Create(mainMenu, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = isCollapsed and UDim2.new(0, 320, 0, 46) or menuSize,
            BackgroundTransparency = 0
        }):Play()
    else
        local tween = TweenService:Create(mainMenu, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 320, 0, 0),
            BackgroundTransparency = 1
        })
        tween:Play()
        tween.Completed:Wait()
        mainMenu.Visible = false
    end
end

