-- === Логика дюпа ===
local isDuping = false
local dupConnection = nil
local dupStartTime = 0

local function resetDupUI()
    isDuping = false
    if dupConnection then
        dupConnection:Disconnect()
        dupConnection = nil
    end
    progressCard.Visible = false
    statusLabel.Visible = false
    dupButton.Text = "Запустить"
    dupButton.BackgroundColor3 = THEME.Accent
    progressBarFill.Size = UDim2.new(0, 0, 1, 0)
    progressPercent.Text = "0%"
end

local function startDup()
    if isDuping then return end
    isDuping = true
    dupStartTime = tick()
    
    progressCard.Visible = true
    statusLabel.Visible = false
    dupButton.Text = "Остановить"
    dupButton.BackgroundColor3 = THEME.Danger
    
    dupConnection = RunService.Heartbeat:Connect(function()
        if not isDuping then return end
        
        local elapsed = tick() - dupStartTime
        local progress = math.min(elapsed / 60 * 100, 100)
        
        TweenService:Create(progressBarFill, TweenInfo.new(0.1, Enum.EasingStyle.Linear), {
            Size = UDim2.new(progress / 100, 0, 1, 0)
        }):Play()
        
        progressPercent.Text = string.format("%d%%", math.floor(progress))
        
        if progress >= 100 then
            isDuping = false
            if dupConnection then
                dupConnection:Disconnect()
                dupConnection = nil
            end
            
            statusLabel.Text = "✅ Успешно завершено!"
            statusLabel.Visible = true
            dupButton.Text = "Готово"
            dupButton.BackgroundColor3 = THEME.Success
            
            task.delay(4, function()
                if not isDuping then
                    resetDupUI()
                end
            end)
        end
    end)
end

dupButton.MouseButton1Click:Connect(function()
    if isDuping then
        resetDupUI()
    else
        startDup()
    end
end)

