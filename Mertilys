local function updateCharacterRefs(char)
    Modules.Character = char
    if char then
        Modules.Humanoid = char:WaitForChild("Humanoid", 5)
        Modules.RootPart = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
